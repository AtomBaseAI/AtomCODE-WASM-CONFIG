// AtomCode — unified schema (Admin + Staff + Student)
// PostgreSQL (Neon) edition — migrated from the SQLite build.
//
// PostgreSQL optimizations applied on top of the original unified schema:
// 1. datasource provider = "postgresql" (Neon pooler endpoint, sslmode=require).
// 2. Long-form content columns are explicit `@db.Text` (descriptions, source
//    code, judge I/O vectors, user submissions, snippets). Postgres `text`
//    has no length overhead and no silent truncation — ideal for judge data.
// 3. Added the FK indexes Postgres does NOT create automatically:
//    UserCodeQuestionData.questionId and userAssessmentCodeData.questionId
//    (hot paths: cascading deletes and per-question result joins).
// 4. Composite uniques (@@unique([userId, questionId])) double as the
//    userId-prefix lookup index for retake/upsert paths — no duplicate index.
// 5. status/difficulty/lang columns intentionally stay String (not native
//    enums): the UI writes a controlled set of values, but retake / CSV
//    import flows must never hard-fail on a new value. Prisma String maps
//    to Postgres text, which is already the optimal storage.
// 6. No @@map aliases needed — fresh Postgres database, no legacy SQLite
//    table names to preserve.
// 7. Dropped the unused SuperAdmin & malformed Account models (credentials
//    + JWT auth only — no OAuth, so no Account/Session tables required).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  image    String?
  password String
}

model Staff {
  id          String        @id @default(cuid())
  name        String?
  email       String        @unique
  phone       String?
  image       String?
  department  String?
  staffnumber String?
  password    String
  StaffCourse StaffCourse[]
}

model User {
  id                     String                   @id @default(cuid())
  name                   String?
  department             String?
  section                String?
  batch                  String?
  rollnumber             String?
  github                 String?
  linkedin               String?
  email                  String                   @unique
  phone                  String?
  emailVerified          DateTime?
  image                  String?
  password               String
  isActive               Boolean                  @default(true)
  isTwoFactorEnabled     Boolean                  @default(false)
  userCourses            UserCourse[]
  userModuleData         UserModuleData[]
  userMCQData            UserMCQData[]
  userCodeQuestionData   UserCodeQuestionData[]
  userAssessmentMCQData  userAssessmentMCQData[]
  userAssessmentCodeData userAssessmentCodeData[]
  UserAssessmentData     UserAssessmentData[]
}

model Course {
  id                 String               @id @default(uuid())
  title              String
  startdate          DateTime
  enddate            DateTime
  language           String
  userCourses        UserCourse[]
  staffCourses       StaffCourse[]
  assessments        Assessments[]
  modules            Module[]
  userModuleData     UserModuleData[]
  feedbacks          Feedbacks[]
  UserAssessmentData UserAssessmentData[]
}

model Feedbacks {
  id       String   @id @default(uuid())
  courseId String
  title    String
  link     String
  date     DateTime
  Course   Course?  @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

model Module {
  id                   String                 @id @default(uuid())
  title                String
  courseId             String
  course               Course                 @relation(fields: [courseId], references: [id])
  moduledate           DateTime
  modulestatus         String
  language             String
  maxscore             Int
  concepturl           String?
  mcqQuestions         MCQQuestion[]
  codeQuestions        CodeQuestion[]
  userModuleData       UserModuleData[]
  userMCQData          UserMCQData[]
  userCodeQuestionData UserCodeQuestionData[]
  reference            ModuleReferences[]

  @@index([courseId])
}

model ModuleReferences {
  id       String  @id @default(uuid())
  title    String
  link     String
  type     String
  Module   Module? @relation(fields: [moduleId], references: [id])
  moduleId String?

  @@index([moduleId])
}

model UserModuleData {
  id                 String  @id @default(uuid())
  userId             String
  courseId           String
  moduleId           String
  mcqtime            Int?
  mcqstatus          String?
  usermcqscore       Int?
  totalmcqscore      Int?
  questiontime       Int?
  questionstatus     String?
  userquestionscore  Int?
  totalquestionscore Int?
  errors             Int?
  compiles           Int?
  modulemaxscore     Int?
  modulestatus       String
  user               User    @relation(fields: [userId], references: [id])
  course             Course  @relation(fields: [courseId], references: [id])
  module             Module  @relation(fields: [moduleId], references: [id])

  @@index([userId, courseId, moduleId])
  @@index([courseId])
  @@index([moduleId])
}

model CodeQuestion {
  id                     String                   @id @default(uuid())
  title                  String
  description            String                   @db.Text
  moduleId               String?
  module                 Module?                  @relation(fields: [moduleId], references: [id])
  sampleinput1           String                   @db.Text
  sampleinput2           String                   @db.Text
  sampleoutput1          String                   @db.Text
  sampleoutput2          String                   @db.Text
  input1                 String                   @db.Text
  input2                 String                   @db.Text
  input3                 String                   @db.Text
  output1                String                   @db.Text
  output2                String                   @db.Text
  output3                String                   @db.Text
  sourcecode             String?                  @db.Text
  referenceimg           String?
  maxscore               Int
  difficulty             String
  lang                   String
  topic                  String?
  subtopic               String?
  inputconstrains        String?                  @db.Text
  blacklist              String?                  @db.Text
  whitelist              String?                  @db.Text
  userCodeQuestionData   UserCodeQuestionData[]
  userAssessmentCodeData userAssessmentCodeData[]
  Assessments            Assessments?             @relation(fields: [assessmentsId], references: [id])
  assessmentsId          String?
  questionGroupId        String?
  questionGroup          QuestionGroup?           @relation(fields: [questionGroupId], references: [id], onDelete: SetNull)

  @@index([moduleId])
  @@index([assessmentsId])
  @@index([questionGroupId])
}

model QuestionGroup {
  id          String         @id @default(uuid())
  title       String
  description String?        @db.Text
  createdAt   DateTime       @default(now())
  questions   CodeQuestion[]

  @@index([title])
}

model UserCodeQuestionData {
  id              String       @id @default(uuid())
  userId          String
  questionId      String       @default(cuid())
  moduleId        String
  score           Int
  compiles        Int
  errors          Int
  submissiontype  String
  tabswitches     Int
  status          String
  usercode        String?      @db.Text
  duration        String?
  testcase1status String?
  testcase2status String?
  testcase3status String?
  user            User         @relation(fields: [userId], references: [id])
  codeQuestion    CodeQuestion @relation(fields: [questionId], references: [id])
  module          Module       @relation(fields: [moduleId], references: [id])

  @@unique([userId, questionId])
  @@index([moduleId])
  @@index([userId, moduleId])
  @@index([questionId])
}

model MCQQuestion {
  id            String       @id @default(uuid())
  title         String
  description   String       @db.Text
  topic         String?
  subtopic      String?
  Option1       String
  Option2       String
  Option3       String
  Option4       String
  CorrectOption Int
  moduleId      String?
  referenceimg  String?
  codesnippet   String?      @db.Text
  iscodesnippet Boolean
  module        Module?      @relation(fields: [moduleId], references: [id])
  Assessments   Assessments? @relation(fields: [assessmentsId], references: [id])
  assessmentsId String?

  @@index([moduleId])
  @@index([assessmentsId])
}

model UserMCQData {
  id             String  @id @default(uuid())
  userId         String
  moduleId       String
  score          Int
  errors         Int
  submissiontype String
  tabswitches    Int
  status         String
  duration       String?
  user           User    @relation(fields: [userId], references: [id])
  module         Module  @relation(fields: [moduleId], references: [id])

  @@index([userId, moduleId])
  @@index([moduleId])
}

model StaffCourse {
  id       String  @id @default(uuid())
  staffId  String
  courseId String
  active   Boolean
  staff    Staff   @relation(fields: [staffId], references: [id])
  course   Course  @relation(fields: [courseId], references: [id])

  @@index([staffId])
  @@index([courseId])
}

model UserCourse {
  id                   String  @id @default(uuid())
  userId               String
  courseId             String
  active               Boolean
  completionPercentage Float
  user                 User    @relation(fields: [userId], references: [id])
  course               Course  @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([courseId])
}

model Assessments {
  id                     String                   @id @default(uuid())
  title                  String
  date                   DateTime
  accesskey              Int
  language               String
  courseId               String
  maxtime                String
  active                 Boolean
  maxscore               Int
  tabswitches            Int
  course                 Course                   @relation(fields: [courseId], references: [id])
  mcqQuestions           MCQQuestion[]
  codeQuestions          CodeQuestion[]
  UserAssessmentData     UserAssessmentData[]
  userAssessmentMCQData  userAssessmentMCQData[]
  userAssessmentCodeData userAssessmentCodeData[]

  @@index([courseId])
}

model userAssessmentMCQData {
  id             String      @id @default(uuid())
  userId         String
  assessmentId   String
  score          Int
  errors         Int
  submissiontype String
  status         String
  duration       String?
  user           User        @relation(fields: [userId], references: [id])
  assessments    Assessments @relation(fields: [assessmentId], references: [id])

  @@index([userId, assessmentId])
  @@index([assessmentId])
}

model userAssessmentCodeData {
  id              String       @id @default(uuid())
  userId          String
  questionId      String       @default(cuid())
  assessmentId    String
  score           Int
  compiles        Int
  errors          Int
  submissiontype  String
  status          String
  usercode        String?      @db.Text
  duration        String?
  testcase1status String?
  testcase2status String?
  testcase3status String?
  user            User         @relation(fields: [userId], references: [id])
  codeQuestion    CodeQuestion @relation(fields: [questionId], references: [id])
  assessments     Assessments  @relation(fields: [assessmentId], references: [id])

  @@unique([userId, questionId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
  @@index([questionId])
}

model UserAssessmentData {
  id                      String      @id @default(uuid())
  userId                  String
  courseId                String
  assessmentId            String
  mcqtime                 Int?
  mcqstatus               String?
  usermcqscore            Int?
  totalmcqscore           Int?
  questiontime            Int?
  questionstatus          String?
  userquestionscore       Int?
  totalquestionscore      Int?
  errors                  Int?
  compiles                Int?
  assessmentmaxscore      Int?
  assessmentstarttime     String
  userassessmentstarttime String
  usertabswitches         Int
  maxtabswitches          Int
  submissiontype          String?
  status                  String
  maxtime                 String
  userduration            String?
  user                    User        @relation(fields: [userId], references: [id])
  course                  Course      @relation(fields: [courseId], references: [id])
  assessments             Assessments @relation(fields: [assessmentId], references: [id])

  @@index([userId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
  @@index([courseId])
}
