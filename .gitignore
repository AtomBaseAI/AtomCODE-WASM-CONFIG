# ============================================================
# AtomCODE — .gitignore
# Stack: Next.js 16 + TypeScript + Prisma (PostgreSQL/Neon)
#        + Bun + WASM runtimes + Electron wrapper + Vercel
# ============================================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
.jspm/

# ---- Next.js build output ----
.next/
out/
build/
dist/

# ---- Environment & secrets (never commit) ----
# All .env* files are ignored; only the sanitized example is tracked.
.env*
!.env.example

# ---- Vercel ----
.vercel

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Logs & debug output ----
logs/
dev.log
server.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Caches ----
.eslintcache
.stylelintcache
.turbo/
.cache/
.parcel-cache/
.rollup.cache/

# ---- Test coverage ----
coverage/
*.lcov
.nyc_output/

# ---- Databases (local SQLite leftovers) ----
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- Runtime uploads & sandbox artifacts ----
upload/
uploads/
tool-results/
agent-ctx/
worklog.md

# ---- Electron wrapper (build artifacts only; source & renderer assets stay tracked) ----
elcetron/dist/
elcetron/out/
elcetron/release/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors / IDEs ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Misc secrets / keys ----
*.pem
*.key
.certs/

# ---- Python helper scripts ----
__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store
